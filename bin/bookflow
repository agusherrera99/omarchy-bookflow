        "progress": "{current} of {total} {unit} read, {remaining} left",
        "estimate": "About {sessions} sessions / {days} days left (confidence: {confidence})",
        "next_up": "Next up: {title}",
        "unknown_setting": "Unknown setting: {key}",
        "bad_value": "Invalid value for {key}: {value}",
        "unit_page": "pages",
        "unit_estimated_page": "estimated pages",
        "confidence_none": "not enough data",
        "confidence_low": "low",
        "confidence_medium": "medium",
        "confidence_high": "high",
    },
    "es": {
        "no_active_book": "Sin libro activo",
        "no_such_book": "No hay libro con id {id}",
        "empty_catalog": "No se encontraron libros en {path}",
        "scanned": "Se escanearon {count} libros en {path}",
        "now_reading": "Leyendo ahora: {title}",
        "restarted": "Releyendo desde el principio: {title}",
        "finished": "Terminado: {title}",
        "paused": "Pausado: {title}",
        "page_set": "Página fijada en {page}",
