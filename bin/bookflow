#!/usr/bin/env python3
"""Reading progress tracker behind the Omarchy Bookflow plugin.

The plugin panel is the everyday interface; this process owns the library
database, reads the last page from the document viewer, and turns reading
history into a finish estimate.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import math
import os
import re
import shutil
import sqlite3
import statistics
import subprocess
import sys
import zipfile
from pathlib import Path
from typing import Any, Callable, Iterable

SCHEMA_VERSION = 2
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "bookflow"
DB_PATH = DATA_DIR / "library.sqlite3"

BOOK_SUFFIXES = {".pdf", ".epub"}
SKIPPED_DIRS = {".git", "99_review"}
WORDS_PER_ESTIMATED_PAGE = 250
PACE_WINDOW_SESSIONS = 10
# A page moving is the evidence that you are reading, but only if it moved at a
# speed a person could read at. Anything faster is navigation — jumping to the
# index, to a bookmark, to the end — and crediting it as reading would let one
# flick through a book outweigh weeks of real sessions in the pace average.
MAX_PAGES_PER_MINUTE = 20
MIN_SAMPLE_ALLOWANCE = 5
RATE_WINDOW_DAYS = 28

DEFAULTS: dict[str, str] = {
    "language": "en",
    "reader": "evince",
    "catalog_path": str(Path.home() / "Documents" / "books"),
    "pages_per_session": "10",
    "sessions_per_week": "5",
    "session_gap_minutes": "15",
    "current_book_id": "",
}

STRINGS: dict[str, dict[str, str]] = {
    "en": {
        "no_active_book": "No active book",
        "no_such_book": "No book with id {id}",
        "empty_catalog": "No books found in {path}",
        "scanned": "Scanned {count} books in {path}",
        "now_reading": "Now reading: {title}",
        "restarted": "Reading again from the start: {title}",
