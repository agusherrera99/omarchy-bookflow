        "estimate": "Faltan unas {sessions} sesiones / {days} días (confianza: {confidence})",
        "next_up": "Sigue: {title}",
        "unknown_setting": "Ajuste desconocido: {key}",
        "bad_value": "Valor inválido para {key}: {value}",
        "unit_page": "páginas",
        "unit_estimated_page": "páginas estimadas",
        "confidence_none": "sin datos suficientes",
        "confidence_low": "baja",
        "confidence_medium": "media",
        "confidence_high": "alta",
    },
}

SCHEMA = """
CREATE TABLE IF NOT EXISTS meta (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS settings (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS books (
    id INTEGER PRIMARY KEY,
    path TEXT NOT NULL UNIQUE,
    catalog_root TEXT NOT NULL DEFAULT '',
    title TEXT NOT NULL,
    format TEXT NOT NULL,
    unit_type TEXT NOT NULL DEFAULT 'page',
    total_pages INTEGER NOT NULL DEFAULT 0,
    collection TEXT NOT NULL DEFAULT '',
    priority INTEGER NOT NULL DEFAULT 50,
    status TEXT NOT NULL DEFAULT 'queued',
    current_page INTEGER NOT NULL DEFAULT 0,
    furthest_page INTEGER NOT NULL DEFAULT 0,
    started_at TEXT,
    completed_at TEXT,
    updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS sessions (
    id INTEGER PRIMARY KEY,
    book_id INTEGER NOT NULL REFERENCES books(id) ON DELETE CASCADE,
    started_at TEXT NOT NULL,
    ended_at TEXT,
    last_sample_at TEXT NOT NULL,
    start_page INTEGER NOT NULL DEFAULT 0,
    end_page INTEGER NOT NULL DEFAULT 0,
    pages INTEGER NOT NULL DEFAULT 0,
    active_minutes REAL NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS sessions_book_idx ON sessions(book_id, started_at);
CREATE INDEX IF NOT EXISTS sessions_open_idx ON sessions(ended_at);
"""


def now() -> dt.datetime:
    return dt.datetime.now().replace(microsecond=0)


def iso(value: dt.datetime | None = None) -> str:
    return (value or now()).isoformat(timespec="seconds")


def parse_iso(value: str | None) -> dt.datetime | None:
    if not value:
        return None
    try:
        return dt.datetime.fromisoformat(value)
    except ValueError:
        return None


def run_text(command: list[str], timeout: int = 8) -> str | None:
    try:
        result = subprocess.run(
            command, text=True, capture_output=True, timeout=timeout, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout if result.returncode == 0 else None


# --- reader adapters ------------------------------------------------------
#
# Every adapter answers the same question: what page is this file open at,
# 1-based, or None when the reader has never saved a position for it.


def gvfs_position(attribute: str) -> Callable[[Path], int | None]:
    def read(path: Path) -> int | None:
        output = run_text(["gio", "info", "-a", attribute, str(path)])
        if not output:
            return None
        match = re.search(re.escape(attribute) + r":\s*(\d+)", output)
        return int(match.group(1)) + 1 if match else None

    return read


def zathura_position(path: Path) -> int | None:
    history = Path.home() / ".local/share/zathura/history"
    try:
        history_text = history.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return None
    target = str(path)
    section = None
    for line in history_text.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
            continue
        if section != target:
            continue
        match = re.match(r"page\s*=\s*(\d+)", stripped)
        if match:
            return int(match.group(1)) + 1
    return None


def okular_position(path: Path) -> int | None:
    docdata = Path.home() / ".local/share/okular/docdata"
    suffix = f".{path.name}.xml"
    try:
        candidates = [entry for entry in docdata.iterdir() if entry.name.endswith(suffix)]
    except OSError:
        return None
    for entry in candidates:
        try:
            entry_text = entry.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        match = re.search(r'<current\s+viewport="(\d+)', entry_text)
        if match:
            return int(match.group(1)) + 1
    return None


READERS: dict[str, dict[str, Any]] = {
    "evince": {
        "label": "Document Viewer",
        "position": gvfs_position("metadata::evince::page"),
        "formats": ["pdf"],
    },
    "papers": {
        "label": "Papers",
        "position": gvfs_position("metadata::papers::page"),
        "formats": ["pdf"],
    },
    "xreader": {
        "label": "Xreader",
        "position": gvfs_position("metadata::xreader::page"),
        "formats": ["pdf"],
    },
    "atril": {
        "label": "Atril",
        "position": gvfs_position("metadata::atril::page"),
        "formats": ["pdf"],
    },
    "zathura": {"label": "Zathura", "position": zathura_position, "formats": ["pdf"]},
    "okular": {"label": "Okular", "position": okular_position, "formats": ["pdf", "epub"]},
    "foliate": {"label": "Foliate", "position": None, "formats": ["epub"]},
    "ebook-viewer": {
        "label": "Calibre E-book Viewer",
        "position": None,
        "formats": ["pdf", "epub"],
    },
    "mupdf": {"label": "MuPDF", "position": None, "formats": ["pdf", "epub"]},
}


def reader_info(reader_id: str) -> dict[str, Any]:
    entry = READERS.get(reader_id, {})
    executable = shutil.which(reader_id)
    return {
        "id": reader_id,
        "label": entry.get("label", reader_id),
        "executable": executable or "",
        "available": bool(executable),
        "captures": entry.get("position") is not None,
        "formats": entry.get("formats", ["pdf", "epub"]),
    }


def read_position(reader_id: str, path: Path) -> int | None:
    entry = READERS.get(reader_id)
    if not entry or not entry.get("position"):
        return None
    if not path.exists():
        return None
    return entry["position"](path)


# --- database -------------------------------------------------------------


def connect() -> sqlite3.Connection:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(DB_PATH)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA foreign_keys = ON")
    db.executescript(SCHEMA)
    db.execute(
        "INSERT INTO meta(key, value) VALUES('schema_version', ?) "
        "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
        (str(SCHEMA_VERSION),),
    )
    db.commit()
    return db


def setting(db: sqlite3.Connection, key: str) -> str:
    row = db.execute("SELECT value FROM settings WHERE key = ?", (key,)).fetchone()
    return row["value"] if row else DEFAULTS.get(key, "")


def set_setting(db: sqlite3.Connection, key: str, value: str) -> None:
    db.execute(
        "INSERT INTO settings(key, value) VALUES(?, ?) "
        "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
        (key, value),
    )


def number_setting(db: sqlite3.Connection, key: str) -> float:
    try:
        return float(setting(db, key))
    except ValueError:
        return float(DEFAULTS.get(key, "0") or 0)


def language(db: sqlite3.Connection) -> str:
    value = setting(db, "language")
    return value if value in STRINGS else "en"


def text(db: sqlite3.Connection, name: str, **fields: Any) -> str:
    table = STRINGS.get(language(db), STRINGS["en"])
    return table.get(name, STRINGS["en"].get(name, name)).format(**fields)


def catalog_path(db: sqlite3.Connection) -> Path:
    override = os.environ.get("BOOKFLOW_CATALOG")
    return Path(override or setting(db, "catalog_path")).expanduser()


# --- catalog scanning -----------------------------------------------------


def title_for(path: Path) -> str:
    stem = re.sub(r"\s+--.*$", "", path.stem).strip()
    if "_" in stem or stem.islower():
        words = stem.replace("_", " ").split()
        stem = " ".join(word if word.isupper() else word.capitalize() for word in words)
    return stem or path.stem


def collection_for(relative: Path) -> tuple[str, int]:
    if len(relative.parts) < 2:
        return "", 50
    top = relative.parts[0]
    match = re.match(r"^(\d+)[_-](.*)$", top)
    if match:
        return match.group(2), int(match.group(1))
    return top, 50


def pdf_pages(path: Path) -> int:
    output = run_text(["pdfinfo", str(path)])
    if not output:
        return 0
    match = re.search(r"^Pages:\s+(\d+)", output, re.MULTILINE)
    return int(match.group(1)) if match else 0


def epub_estimated_pages(path: Path) -> int:
    words = 0
    try:
        with zipfile.ZipFile(path) as archive:
            for name in archive.namelist():
                if not name.lower().endswith((".xhtml", ".html", ".htm")):
                    continue
                raw = archive.read(name).decode("utf-8", errors="ignore")
                plain = re.sub(r"<[^>]+>", " ", raw)
                words += len(re.findall(r"\b[\w’'-]+\b", plain))
    except (OSError, zipfile.BadZipFile, KeyError):
        return 0
    return max(1, math.ceil(words / WORDS_PER_ESTIMATED_PAGE)) if words else 0


def catalog_files(root: Path) -> Iterable[Path]:
    if not root.is_dir():
        return []
    return sorted(
        path
        for path in root.rglob("*")
        if path.is_file()
        and path.suffix.lower() in BOOK_SUFFIXES
        and not SKIPPED_DIRS.intersection(path.parts)
    )


def scan(db: sqlite3.Connection) -> tuple[int, Path]:
    root = catalog_path(db).resolve()
    seen: set[str] = set()
    for path in catalog_files(root):
        relative = path.relative_to(root)
        key = str(relative)
        seen.add(key)
        collection, priority = collection_for(relative)
        fmt = path.suffix.lower().lstrip(".")
        pages = pdf_pages(path) if fmt == "pdf" else epub_estimated_pages(path)
        unit_type = "page" if fmt == "pdf" else "estimated_page"
        db.execute(
            """
            INSERT INTO books(path, catalog_root, title, format, unit_type, total_pages,
                              collection, priority, updated_at)
            VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(path) DO UPDATE SET
                catalog_root = excluded.catalog_root,
                title = excluded.title,
                format = excluded.format,
                unit_type = excluded.unit_type,
                total_pages = CASE WHEN excluded.total_pages > 0
                                   THEN excluded.total_pages ELSE books.total_pages END,
                collection = excluded.collection,
                priority = excluded.priority,
                updated_at = excluded.updated_at
            """,
            (key, str(root), title_for(path), fmt, unit_type, pages, collection, priority, iso()),
        )

    for row in db.execute("SELECT id, path, furthest_page FROM books").fetchall():
        if row["path"] in seen:
            continue
        if row["furthest_page"] > 0:
            db.execute("UPDATE books SET status = 'missing' WHERE id = ?", (row["id"],))
        else:
            db.execute("DELETE FROM books WHERE id = ?", (row["id"],))

    db.commit()
    return len(seen), root


# --- book views -----------------------------------------------------------


def book_path(row: sqlite3.Row) -> Path:
    root = row["catalog_root"] or ""
    return Path(root) / row["path"] if root else Path(row["path"])


def book_view(row: sqlite3.Row) -> dict[str, Any]:
    total = int(row["total_pages"] or 0)
    furthest = int(row["furthest_page"] or 0)
    remaining = max(0, total - furthest)
    percent = round(furthest / total * 100, 1) if total > 0 else 0.0
    return {
        "id": row["id"],
        "title": row["title"],
        "path": str(book_path(row)),
        "relative_path": row["path"],
        "format": row["format"],
        "unit_type": row["unit_type"],
        "collection": row["collection"],
        "status": row["status"],
        "total_pages": total,
        "current_page": int(row["current_page"] or 0),
        "furthest_page": furthest,
        "remaining_pages": remaining,
        "progress_percent": percent,
        "started_at": row["started_at"],
        "completed_at": row["completed_at"],
        "updated_at": row["updated_at"],
    }


def active_book(db: sqlite3.Connection) -> sqlite3.Row | None:
    """The book the panel is showing, which is not the same as a book being read.

    A finished book stays finished when you pick it to look something up; only
    its status says whether samples count.
    """
    current = setting(db, "current_book_id")
    if current.isdigit():
        row = find_book(db, int(current))
        if row is not None and row["status"] != "missing":
            return row
    return db.execute(
        "SELECT * FROM books WHERE status = 'active' ORDER BY updated_at DESC LIMIT 1"
    ).fetchone()


def find_book(db: sqlite3.Connection, book_id: int) -> sqlite3.Row | None:
    return db.execute("SELECT * FROM books WHERE id = ?", (book_id,)).fetchone()


def queue(db: sqlite3.Connection, limit: int = 5) -> list[dict[str, Any]]:
    rows = db.execute(
        "SELECT * FROM books WHERE status IN ('queued', 'paused') "
        "ORDER BY status = 'paused' DESC, priority ASC, furthest_page DESC, title ASC LIMIT ?",
        (limit,),
    ).fetchall()
    return [book_view(row) for row in rows]


# --- session tracking -----------------------------------------------------


def open_session(db: sqlite3.Connection, book_id: int) -> sqlite3.Row | None:
    return db.execute(
        "SELECT * FROM sessions WHERE book_id = ? AND ended_at IS NULL "
        "ORDER BY started_at DESC LIMIT 1",
        (book_id,),
    ).fetchone()


def close_stale_sessions(db: sqlite3.Connection, gap_minutes: float) -> None:
    cutoff = now() - dt.timedelta(minutes=gap_minutes)
    for row in db.execute("SELECT id, last_sample_at FROM sessions WHERE ended_at IS NULL"):
        sampled = parse_iso(row["last_sample_at"])
        if sampled is None or sampled <= cutoff:
            db.execute(
                "UPDATE sessions SET ended_at = COALESCE(last_sample_at, started_at) WHERE id = ?",
                (row["id"],),
            )


def record_progress(db: sqlite3.Connection, row: sqlite3.Row, page: int) -> dict[str, Any]:
    gap_minutes = number_setting(db, "session_gap_minutes")
    previous_page = int(row["current_page"] or 0)
    furthest = max(int(row["furthest_page"] or 0), page)
    moment = now()

    close_stale_sessions(db, gap_minutes)
    session = open_session(db, row["id"])
    navigated = False

    if session is None:
        start_page = previous_page if previous_page > 0 else max(0, page - 1)
        cursor = db.execute(
            """
            INSERT INTO sessions(book_id, started_at, last_sample_at,
                                 start_page, end_page, pages, active_minutes)
            VALUES(?, ?, ?, ?, ?, ?, 0)
            """,
            (row["id"], iso(moment), iso(moment), start_page, page, max(0, page - start_page)),
        )
        session_id = int(cursor.lastrowid)
        session_pages = max(0, page - start_page)
    else:
        sampled = parse_iso(session["last_sample_at"]) or moment
        elapsed = max(0.0, (moment - sampled).total_seconds() / 60)
        advance = page - int(session["end_page"] or previous_page)
        allowance = max(MIN_SAMPLE_ALLOWANCE, math.ceil(elapsed * MAX_PAGES_PER_MINUTE))

        if advance < 0 or advance > allowance:
            # Navigation, not reading. The jump still moves where you are, but
            # it ends the stretch being measured and anchors a new one here, so
            # whatever you read from this page on is credited on its own.
            db.execute(
                "UPDATE sessions SET ended_at = ?, end_page = ? WHERE id = ?",
                (iso(moment), int(session["end_page"] or previous_page), session["id"]),
            )
            cursor = db.execute(
                """
                INSERT INTO sessions(book_id, started_at, last_sample_at,
                                     start_page, end_page, pages, active_minutes)
                VALUES(?, ?, ?, ?, ?, 0, 0)
                """,
                (row["id"], iso(moment), iso(moment), page, page),
            )
            session_id = int(cursor.lastrowid)
            session_pages = 0
            navigated = True
        else:
            session_pages = max(0, page - int(session["start_page"] or 0))
            db.execute(
                """
                UPDATE sessions
                   SET last_sample_at = ?, end_page = ?, pages = ?,
                       active_minutes = active_minutes + ?
                 WHERE id = ?
                """,
                (iso(moment), page, session_pages, min(elapsed, gap_minutes), session["id"]),
            )
            session_id = int(session["id"])

    total = int(row["total_pages"] or 0)
    # Completion follows the page just reached, not the furthest ever reached.
    # Those differ once a finished book is picked up again, and keying off the
    # high-water mark would re-finish it on the first sample.
    completed = total > 0 and page >= total
    db.execute(
        """
        UPDATE books
           SET current_page = ?, furthest_page = ?, status = ?,
               started_at = COALESCE(started_at, ?),
               completed_at = CASE WHEN ? THEN ? ELSE completed_at END,
               updated_at = ?
         WHERE id = ?
        """,
        (
            page,
            furthest,
            "done" if completed else "active",
            iso(moment),
            completed,
            iso(moment),
            iso(moment),
            row["id"],
        ),
    )
    db.commit()

    return {
        "captured": True,
        "changed": page != previous_page,
        "page": page,
        "previous_page": previous_page,
        "furthest_page": furthest,
        "session_id": session_id,
        "session_pages": session_pages,
        "navigated": navigated,
        "completed": completed,
        "reason": "ok",
    }


def sync(db: sqlite3.Connection) -> dict[str, Any]:
    row = active_book(db)
    if row is None:
        return {"captured": False, "changed": False, "reason": "no-active-book"}

    # Looking a page up in a book you have finished is not reading it. Without
    # this, consulting one would quietly rewrite the progress it earned.
    if row["status"] != "active":
        return {"captured": False, "changed": False, "reason": "book-not-being-read"}

    reader_id = setting(db, "reader")
    info = reader_info(reader_id)
    if not info["captures"]:
        return {"captured": False, "changed": False, "reason": "reader-has-no-capture"}

    page = read_position(reader_id, book_path(row))
    if page is None:
        return {"captured": False, "changed": False, "reason": "no-saved-position"}

    total = int(row["total_pages"] or 0)
    if total > 0:
        page = min(page, total)

    previous_page = int(row["current_page"] or 0)
    if page == previous_page:
        session = open_session(db, row["id"])
        sampled = parse_iso(session["last_sample_at"]) if session else None
        if sampled and (now() - sampled).total_seconds() < 60:
            return {
                "captured": True,
                "changed": False,
                "page": page,
                "previous_page": previous_page,
                "reason": "unchanged",
            }
        close_stale_sessions(db, number_setting(db, "session_gap_minutes"))
        db.commit()
        return {
            "captured": True,
            "changed": False,
            "page": page,
            "previous_page": previous_page,
            "reason": "unchanged",
        }

    return record_progress(db, row, page)


# --- estimation -----------------------------------------------------------


def recent_sessions(db: sqlite3.Connection) -> list[sqlite3.Row]:
    return db.execute(
        "SELECT pages, started_at, active_minutes FROM sessions "
        "WHERE pages > 0 ORDER BY started_at DESC LIMIT ?",
        (PACE_WINDOW_SESSIONS,),
    ).fetchall()


def reading_rate(db: sqlite3.Connection) -> tuple[float, str]:
    rows = db.execute(
        "SELECT DISTINCT date(started_at) AS day FROM sessions "
        "WHERE pages > 0 AND date(started_at) >= date('now', 'localtime', ?)",
        (f"-{RATE_WINDOW_DAYS} day",),
    ).fetchall()
    days = [parse_iso(row["day"]) for row in rows]
    days = [day for day in days if day is not None]
    if len(days) < 2:
        return number_setting(db, "sessions_per_week"), "configured"
    span = max(1, min(RATE_WINDOW_DAYS, (now() - min(days)).days + 1))
    return max(0.5, len(days) * 7 / span), "history"


def metrics(db: sqlite3.Connection, book: dict[str, Any] | None) -> dict[str, Any]:
    sessions = recent_sessions(db)
    counts = [int(row["pages"]) for row in sessions]
    logged = int(db.execute("SELECT COUNT(*) FROM sessions WHERE pages > 0").fetchone()[0])

    if len(counts) >= 3:
        pace = statistics.fmean(counts)
        pace_source = "history"
    else:
        pace = number_setting(db, "pages_per_session")
        pace_source = "configured"
    pace = max(1.0, pace)

    rate, rate_source = reading_rate(db)

    if logged < 3:
        confidence = "none"
    elif logged < 10:
        confidence = "low"
    else:
        spread = statistics.pstdev(counts) / statistics.fmean(counts) if counts else 1.0
        confidence = "high" if spread < 0.5 else "medium"

    remaining = int(book["remaining_pages"]) if book else 0
    sessions_remaining = math.ceil(remaining / pace) if remaining > 0 else 0
    days_remaining = math.ceil(sessions_remaining / rate * 7) if sessions_remaining > 0 else 0
    eta = (now().date() + dt.timedelta(days=days_remaining)).isoformat() if days_remaining else ""

    today = db.execute(
        "SELECT COALESCE(SUM(pages), 0) FROM sessions "
        "WHERE date(started_at) = date('now', 'localtime')"
    ).fetchone()[0]
    week = db.execute(
        "SELECT COALESCE(SUM(pages), 0) FROM sessions "
        "WHERE date(started_at) >= date('now', 'localtime', '-7 day')"
    ).fetchone()[0]

    return {
        "pace_pages_per_session": round(pace, 1),
        "pace_source": pace_source,
        "sessions_per_week": round(rate, 1),
        "sessions_per_week_source": rate_source,
        "sessions_remaining": sessions_remaining,
        "days_remaining": days_remaining,
        "eta_date": eta,
        "confidence": confidence,
        "sessions_logged": logged,
        "pages_today": int(today or 0),
        "pages_last_7_days": int(week or 0),
    }


# --- payloads -------------------------------------------------------------


def preferences(db: sqlite3.Connection) -> dict[str, Any]:
    return {
        "language": language(db),
        "reader": setting(db, "reader"),
        "catalog_path": str(catalog_path(db)),
        "pages_per_session": int(number_setting(db, "pages_per_session")),
        "sessions_per_week": int(number_setting(db, "sessions_per_week")),
        "session_gap_minutes": int(number_setting(db, "session_gap_minutes")),
    }


def status_payload(db: sqlite3.Connection) -> dict[str, Any]:
    row = active_book(db)
    book = book_view(row) if row else None
    counts = db.execute(
        "SELECT COUNT(*) AS total, "
        "SUM(status = 'done') AS done, "
        "SUM(status = 'missing') AS missing FROM books"
    ).fetchone()
    return {
        "preferences": preferences(db),
        "reader": reader_info(setting(db, "reader")),
        "active": book,
        "metrics": metrics(db, book),
        "queue": queue(db),
        "library": {
            "total": int(counts["total"] or 0),
            "done": int(counts["done"] or 0),
            "missing": int(counts["missing"] or 0),
        },
        "updated_at": iso(),
    }


def books_payload(db: sqlite3.Connection, query: str) -> dict[str, Any]:
    rows = db.execute(
        "SELECT * FROM books WHERE status != 'missing' "
        "ORDER BY priority ASC, collection ASC, title ASC"
    ).fetchall()
    books = [book_view(row) for row in rows]
    needle = query.strip().lower()
    if needle:
        books = [
            book
            for book in books
            if needle in book["title"].lower() or needle in book["collection"].lower()
        ]
    collections: list[str] = []
    for book in books:
        if book["collection"] and book["collection"] not in collections:
            collections.append(book["collection"])
    return {"books": books, "collections": collections}


def readers_payload(db: sqlite3.Connection) -> dict[str, Any]:
    available = [reader_info(reader_id) for reader_id in READERS]
    return {
        "current": setting(db, "reader"),
        "readers": [entry for entry in available if entry["available"]],
        "all": available,
    }


# --- actions --------------------------------------------------------------


def select_book(db: sqlite3.Connection, book_id: int) -> sqlite3.Row | None:
    row = find_book(db, book_id)
    if row is None:
        return None
    db.execute("UPDATE books SET status = 'paused', updated_at = ? WHERE status = 'active'", (iso(),))
    db.execute(
        "UPDATE sessions SET ended_at = COALESCE(last_sample_at, started_at) WHERE ended_at IS NULL"
    )
    set_setting(db, "current_book_id", str(book_id))
    # A finished book stays finished. Choosing it is how you go back to look
    # something up, which is the common reason to reopen a book you have read;
    # restart() is the deliberate way to say you are reading it again.
    if row["status"] != "done":
        db.execute(
            "UPDATE books SET status = 'active', started_at = COALESCE(started_at, ?), "
            "updated_at = ? WHERE id = ?",
            (iso(), iso(), book_id),
        )
    db.commit()
    return find_book(db, book_id)


def restart_book(db: sqlite3.Connection) -> sqlite3.Row | None:
    """Read the current book again from the start, discarding its progress."""
    row = active_book(db)
    if row is None:
        return None
    db.execute(
        "UPDATE sessions SET ended_at = COALESCE(last_sample_at, started_at) "
        "WHERE book_id = ? AND ended_at IS NULL",
        (row["id"],),
    )
    db.execute(
        "UPDATE books SET status = 'active', current_page = 0, furthest_page = 0, "
        "completed_at = NULL, started_at = ?, updated_at = ? WHERE id = ?",
        (iso(), iso(), row["id"]),
    )
    set_setting(db, "current_book_id", str(row["id"]))
    db.commit()
    return find_book(db, row["id"])


def set_page(db: sqlite3.Connection, page: int) -> sqlite3.Row | None:
    row = active_book(db)
    if row is None:
        return None
    total = int(row["total_pages"] or 0)
    page = max(0, min(page, total) if total > 0 else page)
    db.execute(
        "UPDATE books SET current_page = ?, furthest_page = ?, updated_at = ? WHERE id = ?",
        (page, page, iso(), row["id"]),
    )
    db.execute(
        "UPDATE sessions SET ended_at = COALESCE(last_sample_at, started_at) "
        "WHERE book_id = ? AND ended_at IS NULL",
        (row["id"],),
    )
    db.commit()
    return find_book(db, row["id"])


def close_book(db: sqlite3.Connection, status: str) -> sqlite3.Row | None:
    row = active_book(db)
    if row is None:
        return None
    completed = iso() if status == "done" else None
    page = int(row["total_pages"] or 0) if status == "done" else int(row["furthest_page"] or 0)
    db.execute(
        "UPDATE books SET status = ?, completed_at = ?, furthest_page = ?, updated_at = ? "
        "WHERE id = ?",
        (status, completed, page, iso(), row["id"]),
    )
    db.execute(
        "UPDATE sessions SET ended_at = COALESCE(last_sample_at, started_at) "
        "WHERE book_id = ? AND ended_at IS NULL",
        (row["id"],),
    )
    set_setting(db, "current_book_id", "")
    db.commit()
    return find_book(db, row["id"])


def launch_reader(db: sqlite3.Connection) -> dict[str, Any]:
    row = active_book(db)
    if row is None:
        return {"launched": False, "reason": "no-active-book"}
    reader_id = setting(db, "reader")
    executable = shutil.which(reader_id)
    if not executable:
        return {"launched": False, "reason": "reader-missing", "reader": reader_id}
    path = book_path(row)
    if not path.exists():
        return {"launched": False, "reason": "file-missing", "path": str(path)}
    try:
        subprocess.Popen(
            [executable, str(path)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        return {"launched": False, "reason": "launch-failed", "error": str(error)}
    if row["status"] != "active":
        select_book(db, row["id"])
    return {"launched": True, "reader": reader_id, "path": str(path)}


SETTING_VALIDATORS: dict[str, Callable[[str], str]] = {
    "language": lambda value: value if value in STRINGS else "",
    "reader": lambda value: value if value in READERS else "",
    "catalog_path": lambda value: str(Path(value).expanduser()) if value.strip() else "",
    "pages_per_session": lambda value: str(max(1, int(value))),
    "sessions_per_week": lambda value: str(max(1, int(value))),
    "session_gap_minutes": lambda value: str(max(1, int(value))),
}


def apply_preference(db: sqlite3.Connection, key: str, value: str) -> str | None:
    validator = SETTING_VALIDATORS.get(key)
    if validator is None:
        return text(db, "unknown_setting", key=key)
    try:
        normalized = validator(value)
    except (TypeError, ValueError):
        normalized = ""
    if not normalized:
        return text(db, "bad_value", key=key, value=value)
    set_setting(db, key, normalized)
    db.commit()
    return None


# --- plain-text rendering -------------------------------------------------


def print_status(db: sqlite3.Connection, payload: dict[str, Any]) -> None:
    book = payload["active"]
    if book is None:
        print(text(db, "no_active_book"))
        return
    unit = text(db, f"unit_{book['unit_type']}")
    print(f"{book['title']} — {book['progress_percent']}%")
    print(
        text(
            db,
            "progress",
            current=book["furthest_page"],
            total=book["total_pages"],
            unit=unit,
            remaining=book["remaining_pages"],
        )
    )
    figures = payload["metrics"]
    if figures["sessions_remaining"] > 0:
        print(
            text(
                db,
                "estimate",
                sessions=figures["sessions_remaining"],
                days=figures["days_remaining"],
                confidence=text(db, f"confidence_{figures['confidence']}"),
            )
        )
    if payload["queue"]:
        print(text(db, "next_up", title=payload["queue"][0]["title"]))


def emit(payload: Any) -> None:
    json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")


# --- command line ---------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="bookflow", description="Reading tracker for Omarchy")
    commands = parser.add_subparsers(dest="command", required=True)

    scan_command = commands.add_parser("scan", help="Rescan the book catalog")
    scan_command.add_argument("--json", action="store_true")

    status_command = commands.add_parser("status", help="Show reading status")
    status_command.add_argument("--json", action="store_true")

    books_command = commands.add_parser("books", help="List the library")
    books_command.add_argument("--query", default="")
    books_command.add_argument("--json", action="store_true")

    select_command = commands.add_parser("select", help="Set the current book")
    select_command.add_argument("book_id", type=int)
    select_command.add_argument("--json", action="store_true")

    restart_command = commands.add_parser("restart", help="Read the current book again")
    restart_command.add_argument("--json", action="store_true")

    open_command = commands.add_parser("open", help="Open the current book in the reader")
    open_command.add_argument("--json", action="store_true")

    sync_command = commands.add_parser("sync", help="Capture the last page read")
    sync_command.add_argument("--json", action="store_true")

    page_command = commands.add_parser("set-page", help="Set the current page by hand")
    page_command.add_argument("page", type=int)
    page_command.add_argument("--json", action="store_true")

    finish_command = commands.add_parser("finish", help="Mark the current book as finished")
    finish_command.add_argument("--json", action="store_true")

    pause_command = commands.add_parser("pause", help="Pause the current book")
    pause_command.add_argument("--json", action="store_true")

    readers_command = commands.add_parser("readers", help="List detected document readers")
    readers_command.add_argument("--json", action="store_true")

    prefs_command = commands.add_parser("prefs", help="Read or change preferences")
    prefs_command.add_argument("--set", dest="assignments", action="append", default=[])
    prefs_command.add_argument("--json", action="store_true")

    return parser


def main(argv: list[str] | None = None) -> int:
    arguments = build_parser().parse_args(argv)
    db = connect()

    if arguments.command == "scan":
        count, root = scan(db)
        if arguments.json:
            emit({"scanned": count, "catalog_path": str(root)})
        elif count:
            print(text(db, "scanned", count=count, path=root))
        else:
            print(text(db, "empty_catalog", path=root))
        return 0

    if arguments.command == "status":
        payload = status_payload(db)
        emit(payload) if arguments.json else print_status(db, payload)
        return 0

    if arguments.command == "books":
        payload = books_payload(db, arguments.query)
        if arguments.json:
            emit(payload)
        else:
            for book in payload["books"]:
                marker = "*" if book["status"] == "active" else " "
                print(
                    f"{marker} {book['id']:>3}  {book['progress_percent']:>5}%  "
                    f"{book['title']}  [{book['collection']}]"
                )
        return 0

    if arguments.command == "select":
        row = select_book(db, arguments.book_id)
        if row is None:
            message = text(db, "no_such_book", id=arguments.book_id)
            emit({"selected": False, "message": message}) if arguments.json else print(
                message, file=sys.stderr
            )
            return 1
        if arguments.json:
            emit({"selected": True, "book": book_view(row)})
        else:
            print(text(db, "now_reading", title=row["title"]))
        return 0

    if arguments.command == "restart":
        row = restart_book(db)
        if row is None:
            message = text(db, "no_active_book")
            emit({"updated": False, "message": message}) if arguments.json else print(
                message, file=sys.stderr
            )
            return 1
        if arguments.json:
            emit({"updated": True, "book": book_view(row)})
        else:
            print(text(db, "restarted", title=row["title"]))
        return 0

    if arguments.command == "open":
        result = launch_reader(db)
        if arguments.json:
            emit(result)
        elif not result["launched"]:
            if result["reason"] == "reader-missing":
                print(text(db, "reader_missing", reader=result["reader"]), file=sys.stderr)
            else:
                print(text(db, "no_active_book"), file=sys.stderr)
        return 0 if result["launched"] else 1

    if arguments.command == "sync":
        result = sync(db)
        if arguments.json:
            payload = status_payload(db)
            payload["sync"] = result
            emit(payload)
        elif result.get("reason") == "book-not-being-read":
            book = active_book(db)
            print(text(db, "not_reading", title=book["title"] if book else ""), file=sys.stderr)
        elif not result["captured"]:
            print(text(db, "no_position"), file=sys.stderr)
        elif result["changed"]:
            delta = result["page"] - result["previous_page"]
            print(text(db, "synced", page=result["page"], delta=f"{delta:+d}"))
        else:
            print(text(db, "unchanged", page=result["page"]))
        return 0

    if arguments.command == "set-page":
        row = set_page(db, arguments.page)
        if row is None:
            message = text(db, "no_active_book")
            emit({"updated": False, "message": message}) if arguments.json else print(
                message, file=sys.stderr
            )
            return 1
        if arguments.json:
            emit({"updated": True, "book": book_view(row)})
        else:
            print(text(db, "page_set", page=row["current_page"]))
        return 0

    if arguments.command in {"finish", "pause"}:
        status = "done" if arguments.command == "finish" else "paused"
        row = close_book(db, status)
        if row is None:
            message = text(db, "no_active_book")
            emit({"updated": False, "message": message}) if arguments.json else print(
                message, file=sys.stderr
            )
            return 1
        if arguments.json:
            emit({"updated": True, "book": book_view(row)})
        else:
            print(text(db, "finished" if status == "done" else "paused", title=row["title"]))
        return 0

    if arguments.command == "readers":
        payload = readers_payload(db)
        if arguments.json:
            emit(payload)
        else:
            for entry in payload["readers"]:
                marker = "*" if entry["id"] == payload["current"] else " "
                capture = "auto" if entry["captures"] else "manual"
                print(f"{marker} {entry['id']:<14} {entry['label']:<24} {capture}")
        return 0

    if arguments.command == "prefs":
        failures = []
        for assignment in arguments.assignments:
            key, separator, value = assignment.partition("=")
            if not separator:
                failures.append(text(db, "bad_value", key=key, value=""))
                continue
            error = apply_preference(db, key.strip(), value.strip())
            if error:
                failures.append(error)
        if arguments.json:
            payload = preferences(db)
            payload["errors"] = failures
            emit(payload)
        else:
            for failure in failures:
                print(failure, file=sys.stderr)
            for key, value in preferences(db).items():
                print(f"{key}: {value}")
        return 1 if failures else 0

    return 0


if __name__ == "__main__":
    sys.exit(main())
